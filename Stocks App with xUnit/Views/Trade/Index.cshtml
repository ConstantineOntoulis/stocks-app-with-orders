@model Stocks_App_with_xUnit.Models.StockTrade

@{
    ViewBag.Title = "Trade";
}

<input
    type="hidden"
    id="FinnhubToken"
    value="@ViewBag.FinnhubToken"/>

<input
    type="hidden"
    id="StockSymbol"
    value="@Model.StockSymbol"/>

<div class="box trading-panel">

    <div class="stock">

        <h1>
            @Model.StockName
        </h1>

        <h2>
            @Model.StockSymbol
        </h2>

        <div>
            <small>$</small>

            <span class="live-price">
                @Model.Price.ToString("N2")
            </span>
        </div>

        <div>
            Quantity:
            <span id="live-quantity">
                @Model.Quantity
            </span>
        </div>

        <a asp-controller="Trade" asp-action="Details">
            View stock details
        </a>

        <form asp-action="BuyOrder" class="mt">

            @Html.AntiForgeryToken()

            <input type="hidden" name="StockSymbol" value="@Model.StockSymbol"/>
            <input type="hidden" name="StockName" value="@Model.StockName"/>
            <input type="hidden" name="Price" id="order-price"
                   value="@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"/>
            
            <label for="order-quantity" class="form-label">
                Shares to trade:
            </label>
            
            <input type="number" id="order-quantity" name="Quantity" class="form-input" min="1" max="100000" step="1" value="@Model.Quantity" required/>
            
            <div class="mt">
                <button type="submit" class="button button-green-back" asp-controller="Trade" asp-action="BuyOrder">
                    Buy
                </button>
                
                <button type="submit" class="button button-red-back" asp-controller="Trade" asp-action="SellOrder">
                    Sell
                </button>
            </div>

        </form>
        
        @if (ViewBag.Errors is List<string> errors && errors.Count > 0)
        {
            <div class="mt text-red" role="alert">
                @foreach (string error in errors)
                {
                    <p>@error</p>
                }
            </div>
        }
        
        <div class="mt">
            <a asp-controller="Trade" asp-action="Orders">View All Orders</a>
        </div>

    </div>

</div>

<script src="~/Scripts/FinnhubScript.js"></script>